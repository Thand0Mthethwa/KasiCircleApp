# Copy to .env.local, restrict its permissions, and fill your existing database credentials.
# This template is public. Never commit .env.local or real credentials.
DB_URL=jdbc:postgresql://localhost:5432/kasicircle
DB_USERNAME=
DB_PASSWORD=
# Generate a private random JWT key with at least 32 bytes; never use a sample signing key.
JWT_SECRET=
JWT_EXPIRATION=86400000
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
# Optional for backend startup; required only for functioning image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
