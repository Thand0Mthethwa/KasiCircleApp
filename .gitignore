# Java/Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE - IntelliJ
.idea/
*.iml
*.iws

# IDE - VS Code
.vscode/
# Share only sanitized launch/task configurations; other local IDE settings stay ignored.
!/.vscode/
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json

# IDE - Eclipse
.classpath
.project
.settings/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Windows
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Logs
*.log
logs/

# Secrets - Do not commit local configurations
application-local.properties
application-dev.properties
application-secret.properties
.env
.env.*
# Publish only reviewed environment templates; real environment files stay ignored.
!/frontend/.env.example
!/backend/.env.example

# Temporary files
# Browser QA artifacts can contain session/request data; keep them local.
/frontend/test-results/
/frontend/playwright-report/
*.tmp
*.swp
*~
